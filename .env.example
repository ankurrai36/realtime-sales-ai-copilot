# ==============================================================================
# Real-Time Conversational AI Copilot & CRM Orchestrator - Environment Template
# ==============================================================================
# Copy this file to '.env' and fill in your authorized credentials.
# Do NOT commit your populated '.env' file to source control.

# --- LLM Engine (Google Gemini API) ---
# Comma-delimited list of Gemini API keys for seamless quota exhaustion rotation (HTTP 429)
GEMINI_API_KEYS=your_gemini_api_key_1,your_gemini_api_key_2
GEMINI_MODEL=gemini-2.5-flash

# --- Speech-to-Text Streaming Engine (Deepgram Nova-2) ---
# Comma-delimited list of Deepgram project tokens for WebSocket streaming failover
DEEPGRAM_API_KEYS=your_deepgram_api_key_1,your_deepgram_api_key_2

# --- Browser Automation (Chrome DevTools Protocol Remote Debugging Ports) ---
CRM_PORT_SALESFORCE=9222
CRM_PORT_DIALER=9223
CRM_PORT_AISTUDIO=9224

# --- Mobile Trigger Webhook Gateway (Optional / MacroDroid) ---
# Webhook URL or Device UUID used for mobile workstation sync and SMS/WhatsApp routing
MACRODROID_WEBHOOK_URL=https://trigger.macrodroid.com/YOUR_DEVICE_UUID/sales_alert
MACRODROID_DEVICE_ID=your_device_uuid_here

# --- Professional Advisor Identity & Outreach Settings ---
ADVISOR_NAME=Senior Admissions Advisor
ADVISOR_EMAIL=admissions@executive-education.org
ADVISOR_PHONE=+1-555-0199
ORGANIZATION_NAME=Executive Education Consortium
PORTAL_URL=https://portal.executive-education.org/admissions
ASSIGNMENT_EMAIL=assignments@executive-education.org
